# ── 0. Block direct push to main ─────────────────────────────────────────────
# The ruleset already rejects this server-side, so this guard is not what makes
# the rule true — it is what makes finding out cheap. Every gate below runs
# BEFORE the push is attempted: full suite with coverage, jscpd, SonarJS, npm
# audit, Trivy, gitleaks, and two AI review passes. Without this check, pushing
# from main means ~10 minutes of work followed by a server rejection.
#
# Matters more under trunk-based than it did with develop: main is now the only
# long-lived branch, so it is the one you are most likely to be sitting on.
#
# Reads the refs actually being pushed from stdin rather than checking which
# branch you are standing on. `git push origin v1.6.0` pushes a TAG while you
# happen to be on main, and the branch-name check rejected it — blocking the
# v1.6.0 release, which under tag-triggered releases is the deploy itself.
#
# git feeds pre-push one line per ref: <local-ref> <local-sha> <remote-ref>
# <remote-sha>. Only refs/heads/main is a direct push to main; refs/tags/* is
# not, and neither is any other branch. Nothing below reads stdin, so consuming
# it here is safe.
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  case "$remote_ref" in
    refs/heads/main)
      printf '\nPush blocked: direct pushes to main are not allowed.\n'
      printf 'Cut a branch and open a pull request instead.\n'
      printf '(Tags are fine: `git push origin v1.2.3` is how a release ships.)\n'
      exit 1
      ;;
  esac
done

# ── 1. Coverage gate ─────────────────────────────────────────────────────────
# Thresholds are enforced in each jest.config — this fails if any package drops
# below its configured branches/functions/lines/statements floor.
echo "Running tests with coverage..."
pnpm test || exit 1

# ── 2. Duplicate-code gate ───────────────────────────────────────────────────
echo ""
echo "Checking for duplicate code..."
pnpm jscpd || exit 1

# ── 2b. SonarJS lint gate ─────────────────────────────────────────────────────
echo ""
echo "Running SonarJS checks..."
pnpm lint:sonar || exit 1

# ── 3. Dependency vulnerability audit ────────────────────────────────────────
# Blocks on HIGH and CRITICAL CVEs in production dependencies.
# Run `pnpm audit --fix` or add a pnpm.overrides entry to resolve failures.
echo ""
echo "Running dependency vulnerability audit..."
# `&& … || …` keeps the real exit code without tripping the hook's `set -e`
# (husky runs this via `sh -e`, so a bare failing assignment would abort
# the script before the 410-vs-CVE check below).
AUDIT_OUT=$(pnpm audit --prod --audit-level=high 2>&1) && AUDIT_EXIT=0 || AUDIT_EXIT=$?
printf '%s\n' "$AUDIT_OUT"
if [ $AUDIT_EXIT -ne 0 ]; then
  # Distinguish "the audit could not run" from "the audit found something".
  #
  # Both exit non-zero. Conflating them reports a network outage as a critical
  # security finding, which is the worst kind of false positive: it is the one
  # that teaches people to reach for --no-verify, and that habit is what waves
  # a REAL finding through later.
  #
  # Two ways the audit fails to produce a verdict, neither of which assessed a
  # single package:
  #   - the endpoint is retired      (HTTP 410 — npm retired quick-audit)
  #   - the endpoint is unreachable  (socket timeout, DNS failure, reset)
  #
  # A genuine HIGH/CRITICAL result exits non-zero WITHOUT any of these
  # signatures and still blocks below.
  #
  # Findings are checked FIRST, and win. pnpm prints a retry warning
  # ("ERR_SOCKET_TIMEOUT ... Will retry") and can then succeed on a later
  # attempt and report real CVEs — so the same output carries both a transport
  # signature and a genuine verdict. Matching the transport signature first
  # would classify that as "could not run" and wave the finding through, which
  # is a worse bug than the one this whole block exists to fix.
  if printf '%s' "$AUDIT_OUT" | grep -qEi 'vulnerabilit(y|ies) found|Severity:.*(high|critical)'; then
    AUDIT_VERDICT=findings
  elif printf '%s' "$AUDIT_OUT" | grep -qE 'ERR_PNPM_AUDIT_BAD_RESPONSE|being retired|410|ERR_SOCKET_TIMEOUT|Socket timeout|ETIMEDOUT|ECONNRESET|ECONNREFUSED|ENOTFOUND|EAI_AGAIN|FetchError|ERR_PNPM_FETCH'; then
    AUDIT_VERDICT=unreachable
  else
    AUDIT_VERDICT=findings
  fi

  if [ "$AUDIT_VERDICT" = unreachable ]; then
    printf '\nWarning: the dependency audit did NOT run — the npm advisory endpoint was\n'
    printf 'unreachable or retired. This is a transport failure, NOT a clean result:\n'
    printf 'no packages were assessed.\n'
    printf '\nNot blocking this push. CI runs the same audit in its Security Scan job and\n'
    printf 'still gates the PR, so a real finding is caught there.\n'
    printf 'To check locally once the network recovers: pnpm audit --prod --audit-level=high\n'
  else
    printf '\nPush blocked: HIGH or CRITICAL CVEs found in production dependencies.\n'
    printf 'Fix with: pnpm audit --fix   or add a version override to package.json > pnpm.overrides\n'
    printf 'Then run /op-security to confirm clean before pushing.\n'
    exit 1
  fi
fi

# ── 5. Trivy filesystem scan ──────────────────────────────────────────────────
# Mirror of the CI Trivy scan — catches what the npm advisory DB misses
# (e.g. container CVEs that also apply to the lockfile).
if command -v trivy >/dev/null 2>&1; then
  echo ""
  echo "Running Trivy filesystem scan..."
  # --exit-code 1: without it Trivy exits 0 whatever it finds, so the check
  # below was unreachable and this gate had never blocked a push in its life.
  #
  # --ignorefile: Trivy only auto-detects a plain `.trivyignore`, so without
  # this the repo's `.trivyignore.yaml` is never read — the same trap already
  # fixed in ci.yml (`trivyignores:`). The two flags have to land together:
  # --exit-code alone would block every push on advisories we have assessed and
  # accepted (maplibre CVE-2026-85061, unfixable on 5.x per #1187), which is
  # precisely how a gate teaches people to reach for --no-verify.
  trivy fs . --scanners vuln --severity HIGH,CRITICAL --ignore-unfixed --quiet \
    --exit-code 1 --ignorefile .trivyignore.yaml 2>&1
  TRIVY_EXIT=$?
  if [ $TRIVY_EXIT -ne 0 ]; then
    printf '\nPush blocked: HIGH or CRITICAL CVEs found by Trivy.\n'
    printf 'Run /op-security for a full breakdown and fix guidance.\n'
    printf 'If the finding is unfixable and unreachable, add it to\n'
    printf '.trivyignore.yaml WITH a justification and a removal condition —\n'
    printf 'see the maplibre entry for the shape.\n'
    exit 1
  fi
else
  echo "Warning: trivy not found — install with: brew install trivy"
fi

# ── 6. Secret scan ────────────────────────────────────────────────────────────
if command -v gitleaks >/dev/null 2>&1; then
  echo ""
  echo "Running secret scan..."
  gitleaks detect --source . --no-banner --config .gitleaks.toml --exit-code 1 2>&1
  if [ $? -ne 0 ]; then
    printf '\nPush blocked: potential secrets detected by gitleaks.\n'
    printf 'Review the findings above. If a finding is a false positive, add it to .gitleaksignore\n'
    exit 1
  fi
else
  echo "Warning: gitleaks not found — install with: brew install gitleaks"
fi

# ── 6b. Deterministic data scan (fail-closed) ─────────────────────────────────
# scripts/data-scan.ts, vendored from opuspopuli-sdlc (hooks/data-scan.ts). Rules, not a model: card
# numbers, SSNs, Medicare IDs and sensitive fields reaching a log/error/telemetry/prompt call, scoped to
# .sdlc/compliance-profile.yaml (CCPA here). Critical/high findings block; so does a scan that cannot
# run. Accepted false positives go in .sdlc/data-scan-allow.yaml, each with a reason.
echo ""
echo "Running deterministic data scan..."
if ! node --experimental-strip-types scripts/data-scan.ts --base origin/main; then
  printf '\nPush blocked by the data scan. Remove the regulated data, mask it, or record an\n'
  printf 'accepted exception with a reason in .sdlc/data-scan-allow.yaml.\n'
  exit 1
fi

# ── 7–8. AI code review and security review (fail-closed) ────────────────────
# Runs scripts/review-gate.ts, vendored from opuspopuli-sdlc (hooks/review-gate.ts). It replaces the
# inline `claude --print` stages, which failed OPEN three ways:
#   - no claude CLI      → the review was skipped with a warning and the push went through
#   - anything but FAIL: → a crash, an empty answer or prose all counted as a pass
#   - head -c 30000      → a large diff was silently reviewed in part
# Now a review that does not complete blocks: missing CLI, non-zero exit, timeout, unparseable or
# empty answer, or a failed git diff. A critical/high finding blocks whatever the verdict says.
#
# Criteria specific to this repo (GPL deps, Federation/HMAC contracts, the security list) live in
# .sdlc/review/code.md and .sdlc/review/security.md. The compliance profile (.sdlc/) scopes the
# personal-data lens to CCPA, not HIPAA.
#
# Provider: claude by default. Set SDLC_REVIEW_PROVIDER=codex to review with Codex instead (needs
# `codex login`). Override the whole gate only with --no-verify, as before.
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh" --no-use

PROVIDER="${SDLC_REVIEW_PROVIDER:-claude}"

for LENS in code security; do
  echo ""
  echo "Running AI $LENS review ($PROVIDER)..."
  if ! node --experimental-strip-types scripts/review-gate.ts \
      --provider "$PROVIDER" --lens "$LENS" --base origin/main; then
    printf '\nPush blocked by the AI %s review. Fix the finding above, or if the review\n' "$LENS"
    printf 'could not run, install/sign in to the %s CLI and push again.\n' "$PROVIDER"
    printf 'git push --no-verify skips the whole gate; log it as an exception for /op-validate.\n'
    exit 1
  fi
done
