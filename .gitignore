coverage

node_modules
.env

.terraform
*.tfplan

*.tfvars

# NestJS GraphQL autoSchemaFile output (region service) — regenerated on every build
region-schema.gql

# Build outputs
dist/
*.tsbuildinfo

# Infrastructure backup (old modules)
infra-backup/

# Playwright
test-results/
playwright-report/
blob-report/
playwright/.cache/
# Playwright MCP server scratch output (screenshots, traces) — tool artifacts
.playwright-mcp/

# TLS / cert material — generated at build time by Dockerfile.nginx,
# never committed. README in apps/frontend/nginx/.certs/ documents
# how to regenerate locally if you need them on disk for dev.
*.key
*.crt
*.pem
!**/test-fixtures/**/*.pem
!**/__fixtures__/**/*.pem

# macOS
.DS_Store

# Claude Code per-project state (worktrees, tool results, local settings)
# Team config here is force-added deliberately: settings.json (marketplace + enabled plugins) and
# compliance-profile.yaml (which control families apply to this repo — an auditable declaration,
# so it must be in the repo, not a local-only file):
#   git add -f .claude/settings.json .claude/compliance-profile.yaml
.claude/
tmp/

# Local scratch — planning notes, ad-hoc test plans, design sketches.
# Anything in here is intentionally out of git history.
.scratch/
