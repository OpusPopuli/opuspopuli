{
  "name": "opuspopuli",
  "version": "1.0.1",
  "description": "Full-stack civic technology platform with Next.js, NestJS, and 100% OSS AI/ML",
  "main": "index.js",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm run --parallel dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:ci": "pnpm -r test -- --coverage",
    "test:integration": "pnpm --filter backend test:integration",
    "test:integration:docker": "bash scripts/test-integration-docker.sh",
    "integration:up": "NODE_AUTH_TOKEN=${NODE_AUTH_TOKEN:-$(gh auth token)} docker compose -f docker-compose-integration.yml up -d --build",
    "integration:down": "docker compose -f docker-compose-integration.yml down -v",
    "integration:logs": "docker compose -f docker-compose-integration.yml logs -f",
    "uat:up": "NODE_AUTH_TOKEN=${NODE_AUTH_TOKEN:-$(gh auth token)} docker compose -f docker-compose-uat.yml up -d --build",
    "uat:down": "docker compose -f docker-compose-uat.yml down",
    "uat:down:clean": "docker compose -f docker-compose-uat.yml down -v",
    "uat:logs": "docker compose -f docker-compose-uat.yml logs -f",
    "prepare": "husky",
    "lint:sonar": "pnpm -r lint:sonar",
    "jscpd": "jscpd",
    "check:overrides": "node scripts/check-overrides.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0",
  "devDependencies": {
    "eslint-plugin-sonarjs": "^4.0.3",
    "husky": "^9.1.7",
    "jscpd": "^4.1.0",
    "lint-staged": "^15.2.10"
  },
  "lint-staged": {
    "**/*.+(js|jsx|ts|tsx)": [
      "pnpm -r lint",
      "pnpm -r format"
    ],
    "**/*.+(json|css)": [
      "pnpm -r format"
    ]
  },
  "dependencies": {
    "cockatiel": "^3.2.1"
  },
  "pnpm": {
    "overrides": {
      "tar": ">=7.5.19",
      "fast-xml-parser": ">=5.7.0",
      "fast-xml-builder": ">=1.1.7",
      "fast-uri": ">=3.1.6 <4.0.0",
      "lodash": ">=4.18.0",
      "langsmith": ">=0.5.19",
      "protobufjs": ">=8.5.0 <9.0.0",
      "ws": ">=8.20.1",
      "uuid": "^11.1.1",
      "qs": ">=6.16.0 <7.0.0",
      "protocol-buffers-schema": ">=3.6.1",
      "postcss": ">=8.5.18",
      "ip-address": ">=10.3.1",
      "brace-expansion": ">=2.1.6 <3.0.0",
      "minimatch@>=10>brace-expansion": ">=5.0.11",
      "@apollo/gateway": ">=2.12.3",
      "@apollo/query-planner": ">=2.12.3",
      "@apollo/federation-internals": ">=2.12.3",
      "jsdom>undici": ">=8.9.0",
      "miniflare>undici": ">=7.29.1",
      "undici@>=7.0.0 <7.29.1": ">=7.29.1 <8.0.0",
      "shell-quote": ">=1.8.4",
      "flatted": ">=3.4.2",
      "file-type": ">=21.3.1",
      "hono": ">=4.12.27 <5.0.0",
      "@hono/node-server": ">=1.19.15 <2.0.0",
      "next": ">=16.3.6 <17.0.0",
      "handlebars": ">=4.7.9",
      "picomatch": ">=4.0.4",
      "path-to-regexp": ">=8.4.0",
      "@opennextjs/aws>path-to-regexp": "^6.3.0",
      "defu": ">=6.1.5",
      "axios": ">=1.18.0",
      "form-data": ">=4.0.6",
      "multer": ">=2.3.0",
      "next@>=16.0.0 <16.2.6": ">=16.3.6",
      "@opentelemetry/auto-instrumentations-node@<0.75.0": ">=0.75.0",
      "@opentelemetry/sdk-node@<0.217.0": ">=0.217.0",
      "@opentelemetry/exporter-prometheus@<0.217.0": ">=0.217.0",
      "@grpc/grpc-js": ">=1.14.5",
      "joi": ">=18.2.5 <19.0.0",
      "js-yaml": ">=4.3.2 <5.0.0",
      "@opentelemetry/propagator-jaeger": ">=2.9.0",
      "sharp": ">=0.35.5",
      "nanoid@<3.3.17": ">=3.3.17 <4.0.0",
      "deepmerge-ts": ">=8.0.0",
      "browserslist": ">=4.28.7",
      "mysql2": ">=3.22.0",
      "nodemailer": ">=10.0.6 <11.0.0",
      "valibot": ">=1.4.2 <2.0.0",
      "@opentelemetry/core": ">=2.8.0 <3.0.0",
      "body-parser": ">=2.3.0 <3.0.0",
      "fflate": ">=0.8.3 <0.9.0",
      "@babel/core": ">=7.29.6 <8.0.0",
      "@simplewebauthn/server": ">=13.3.2 <14.0.0",
      "proxy-addr": ">=2.0.8",
      "compression": ">=1.8.2",
      "@graphql-tools/utils": ">=12.0.1",
      "source-map-js": ">=1.2.2",
      "http-cache-semantics": ">=4.3.0"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-mh99-v99m-4gvg",
        "GHSA-jrc7-96c5-q579",
        "GHSA-vfj7-8cjw-p6xm"
      ]
    }
  }
}
