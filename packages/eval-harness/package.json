{
  "name": "@opuspopuli/eval-harness",
  "version": "0.1.0",
  "private": true,
  "description": "Retrieval and generation evaluation harness — the measurement instrument for AI-architecture changes (M4).",
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "eval:retrieval": "tsx src/retrieval-eval.ts",
    "eval:baseline": "tsx src/retrieval-eval.ts --provider xenova",
    "typecheck": "tsc --noEmit",
    "eval:ocr": "tsx src/ocr-eval.ts",
    "test": "tsc --noEmit && tsx --test \"src/**/*.spec.ts\"",
    "test:watch": "tsx --test --watch \"src/**/*.spec.ts\"",
    "fixtures:fulltext": "tsx src/build-fulltext-fixture.ts",
    "eval:generation": "tsx src/generation-eval.ts",
    "fixtures:symmetry": "tsx src/build-fulltext-fixture.ts --symmetry",
    "eval:symmetry": "tsx src/symmetry-eval.ts",
    "eval:throughput": "tsx src/throughput-eval.ts",
    "eval:adversarial": "tsx src/adversarial-eval.ts",
    "eval:omission": "tsx src/omission-eval.ts"
  },
  "dependencies": {
    "@opuspopuli/common": "workspace:*",
    "@opuspopuli/embeddings-provider": "workspace:*",
    "@opuspopuli/llm-provider": "workspace:*",
    "@opuspopuli/ocr-provider": "workspace:*",
    "@opuspopuli/prompt-client": "workspace:*",
    "@opuspopuli/relationaldb-provider": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
